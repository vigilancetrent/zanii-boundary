  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests / second",
      "datasource": {
        "type": "prometheus",
        "uid": "runtime-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(runtime_requests_total[5m]))",
          "refId": "A",
          "legendFormat": "{{job}} {{role}} {{state}} {{target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown"
        },
        "overrides": []
      }
    },
    {
