{
  "version": 1,
  "role": "worker",
  "realm": "resource",
  "storage": {
    "backend": "postgres",
    "encryptionKeyFile": "/run/secrets/worker_resource_data_key",
    "auditKeyFile": "/run/secrets/worker_resource_audit_key",
    "keyringFile": "/run/secrets/worker_resource_keyring",
    "retentionMs": 86400000,
    "postgres": {
      "credentialsFile": "/run/secrets/worker_resource_postgres_credentials",
      "caFile": "/run/trust/postgres-ca.pem",
      "maxConnections": 4,
      "acquireTimeoutMs": 1000,
      "queryTimeoutMs": 2000,
      "statementTimeoutMs": 1500,
      "lockTimeoutMs": 500
    }
  },
  "worker": {
    "pollIntervalMs": 1000,
    "leaseMs": 30000,
    "timeoutMs": 20000,
    "batchSize": 10
  },
  "services": {
    "privacy": {},
    "objects": {
      "endpoint": "https://objects.company.invalid",
      "region": "eu-central-1",
      "credentialsFile": "/run/secrets/worker_resource_objects_credentials",
      "caFile": "/run/trust/provider-ca.pem",
      "allowPrivateNetworks": true,
      "timeoutMs": 10000,
      "bucket": "runtime-documents",
      "prefix": "documents",
      "indexKeyFile": "/run/secrets/worker_resource_objects_index_key",
      "encryptionKeyFile": "/run/secrets/worker_resource_objects_data_key",
      "encryptionKeyId": "worker-objects-v1",
      "serverEncryption": "aws:kms",
      "sseKmsKeyId": "REPLACE_WITH_VERIFIED_KMS_KEY_ARN",
      "requireLock": false,
      "maxBytes": 1048576
    }
  },
  "logging": {
    "directory": "/var/log/runtime",
    "maxBytes": 8388608,
    "files": 3,
    "maxQueueBytes": 65536,
    "required": true
  },
  "telemetry": {
    "serviceName": "runtime-worker-resource",
    "samplingRatio": 0.1,
    "maxQueueSize": 512,
    "maxExportBatchSize": 64,
    "exportTimeoutMs": 3000,
    "scheduledDelayMs": 1000,
    "collector": {
      "url": "https://otel-collector:4318/v1/traces",
      "caFile": "/run/trust/monitoring-ca.pem",
      "certFile": "/run/secrets/worker_resource_otel_cert",
      "keyFile": "/run/secrets/worker_resource_otel_key",
      "allowPrivateNetworks": true
    }
  }
}
