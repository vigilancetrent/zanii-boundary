{
  "version": 1,
  "role": "rotator",
  "realm": "gateway",
  "storage": {
    "backend": "postgres",
    "encryptionKeyFile": "/run/secrets/rotator_gateway_data_key",
    "auditKeyFile": "/run/secrets/rotator_gateway_audit_key",
    "keyringFile": "/run/secrets/rotator_gateway_keyring",
    "retentionMs": 86400000,
    "postgres": {
      "credentialsFile": "/run/secrets/rotator_gateway_postgres_credentials",
      "caFile": "/run/trust/postgres-ca.pem",
      "maxConnections": 2,
      "acquireTimeoutMs": 1000,
      "queryTimeoutMs": 2000,
      "statementTimeoutMs": 1500,
      "lockTimeoutMs": 500
    }
  },
  "worker": {
    "pollIntervalMs": 1000,
    "leaseMs": 30000,
    "timeoutMs": 20000,
    "batchSize": 10
  },
  "services": {}
}
