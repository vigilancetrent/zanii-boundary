{
  "version": 1, "role": "gateway", "profile": "production",
  "listen": { "host": "gateway", "port": 8443, "socketPath": "/run/runtime/gateway.sock" },
  "tls": { "certFile": "/run/secrets/gateway_tls_cert", "keyFile": "/run/secrets/gateway_tls_key", "caFile": "/run/trust/ca.pem", "requireClientCertificate": true },
  "auth": { "issuer": "https://REPLACE_WITH_COMPANY_ISSUER", "audience": "company-agent-runtime", "jwksFile": "/run/trust/issuer.jwks.json", "algorithms": ["EdDSA"], "requireSenderBinding": true, "maxLifetimeSeconds": 900 },
  "storage": { "path": "/var/lib/runtime/runtime.sqlite", "encryptionKeyFile": "/run/secrets/gateway_data_key", "auditKeyFile": "/run/secrets/gateway_audit_key", "retentionMs": 604800000 },
  "signing": { "privateKeyFile": "/run/secrets/gateway_signing_key" },
  "limits": { "bodyBytes": 65536, "requestTimeoutMs": 10000, "rateWindowMs": 60000, "rateRequests": 300, "maxConcurrency": 32 },
  "deployment": { "receiptFile": "/run/secrets/containment_receipt", "trustKeyFile": "/run/secrets/containment_trust", "maxAgeMs": 900000, "profileDigest": "REPLACE_WITH_MEASURED_PROFILE_DIGEST", "imageRef": "REPLACE_WITH_VERIFIED_DIGEST_PINNED_PRODUCT_IMAGE" },
  "integrations": { "resource": { "origin": "https://resource:8444", "caFile": "/run/trust/ca.pem", "certFile": "/run/secrets/gateway_tls_cert", "keyFile": "/run/secrets/gateway_tls_key", "issuer": "https://company-runtime-broker", "audience": "company-document-resource", "signingKeyFile": "/run/secrets/gateway_signing_key", "kid": "REPLACE_WITH_BROKER_PUBLIC_KEY_ID", "allowPrivateNetworks": true, "required": true } },
  "protocols": { "mcp": { "allowedOrigins": [] } }
}
