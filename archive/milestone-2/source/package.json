{
  "name": "agent-runtime-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Company agent execution boundary with durable authorization, TLS resource adapters, controlled learning and reproducible local evaluation; deployment acceptance required.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "test:isolated": "node --test test/*.test.mjs",
    "benchmark": "node scripts/benchmark.mjs --transport=in-process",
    "benchmark:process": "node scripts/benchmark.mjs --transport=process",
    "verify": "node scripts/verify.mjs",
    "load": "node scripts/load.mjs --transport=in-process",
    "load:process": "node scripts/load.mjs --transport=process",
    "start": "node scripts/start.mjs",
    "product:evaluate": "node scripts/product-evaluate.mjs",
    "product:load": "node scripts/product-load.mjs",
    "product:check": "node --experimental-vm-modules scripts/product-check.mjs",
    "product:lint": "node scripts/product-tooling.mjs lint",
    "product:typecheck": "node scripts/product-tooling.mjs typecheck",
    "product:verify": "node scripts/product-verify.mjs",
    "product:doctor": "node scripts/doctor.mjs",
    "product:operations": "node scripts/operations.mjs",
    "product:operations-check": "node scripts/operations-check.mjs",
    "product:socket-acceptance": "node --test --test-isolation=none test/acceptance-product-socket.mjs"
  },
  "exports": {
    "./client": "./src/client.mjs",
    "./evidence": "./src/evidence.mjs",
    "./product/client": "./src/product/client.mjs",
    "./product/evidence": "./src/product/evidence.mjs",
    "./product/server": "./src/product/server.mjs"
  },
  "dependencies": {
    "@zanii/broker": "0.1.0",
    "@zanii/core": "0.5.6",
    "@zanii/sdk": "0.5.4",
    "canonicalize": "5.1.0",
    "jose": "6.2.14",
    "zod": "4.6.7"
  }
}
